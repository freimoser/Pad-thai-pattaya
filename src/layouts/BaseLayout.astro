---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, t } from '../data/ui';
import type { Lang } from '../data/restaurants';
import { withBase, langPath } from '../utils/paths';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  schema?: object | object[];
}

const {
  lang,
  title,
  description,
  path = '',
  ogImage,
  type = 'website',
  schema,
} = Astro.props;

const ui = t(lang);
const fullTitle = title.includes(ui.siteName) ? title : `${title} | ${ui.siteName}`;
const canonical = new URL(langPath(lang, path).replace(/^\//, ''), Astro.site).href;
const ogLocale = languages.find((l) => l.code === lang)?.locale ?? 'de_DE';
const imageUrl = ogImage
  ? new URL(ogImage.replace(/^\//, ''), Astro.site).href
  : new URL(withBase('og-default.svg').replace(/^\//, ''), Astro.site).href;

const hreflangs = languages.map((l) => ({
  lang: l.code,
  href: new URL(langPath(l.code, path).replace(/^\//, ''), Astro.site).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={ui.keywords} />
    <meta name="author" content="Pad Thai Pattaya Guide" />
    <meta name="geo.region" content="TH-20" />
    <meta name="geo.placename" content="Pattaya" />
    <meta name="geo.position" content="12.9236;100.8825" />
    <meta name="ICBM" content="12.9236, 100.8825" />
    <link rel="canonical" href={canonical} />
    {hreflangs.map((h) => (
      <link rel="alternate" hreflang={h.lang} href={h.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(langPath('de', path).replace(/^\//, ''), Astro.site).href} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={ui.siteName} />
    {languages.filter((l) => l.code !== lang).map((l) => (
      <meta property="og:locale:alternate" content={l.locale} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <Header lang={lang} currentPath={path} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
